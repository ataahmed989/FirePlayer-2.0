+        assertFalse(LivePause.byItself(Player.PLAY_WHEN_READY_CHANGE_REASON_REMOTE))
+        assertFalse(LivePause.byItself(Player.PLAY_WHEN_READY_CHANGE_REASON_END_OF_MEDIA_ITEM))
+    }
+}
