<?xml version="1.0" encoding="utf-8"?>
<!--
    The app shell. From back to front: the live video surface (behind the window: everything above it must leave a
    hole where video shows), the stationary wallpaper (added in code; it leaves that hole), live captions, the live
    screen dimmer (full screen only), the pages, the tab rail
    (drawn over the page when it widens), and the settings window.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <SurfaceView
        android:id="@+id/live_surface"
        android:layout_width="1dp"
        android:layout_height="1dp" />

    <FrameLayout
        android:id="@+id/wallpaper_host"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Live closed captions, over the full-screen picture (under the live controls). -->
    <androidx.media3.ui.SubtitleView
        android:id="@+id/live_captions"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Screen dimmer over the full-screen live picture and its captions, never the controls or windows above (as the
         VOD player's). -->
    <View
        android:id="@+id/live_dimmer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@color/black"
        android:visibility="gone" />

    <!-- Pages start right of the rail (NavRail.WIDTH_DP); Live TV lays out its own left side (HomeActivity.pageInset). -->
    <FrameLayout
        android:id="@+id/page_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="58dp" />

    <!-- The rail: a slim strip flush with the screen's left edge, full height (no margin around it). -->
    <FrameLayout
        android:id="@+id/rail_host"
        android:layout_width="wrap_content"
        android:layout_height="match_parent" />

    <include
        android:id="@+id/panel"
        layout="@layout/side_panel" />
</FrameLayout>
